<h3>Colors</h3>

<div style="display: flex; justify-content: center;">
    <div class="square" style="width: 40px; height: 40px; margin: 10px; background-color:rgb(230, 230, 230);"></div>
    <div class="square" style="width: 40px; height: 40px; margin: 10px; background-color:rgb(195, 195, 195);"></div>
    <div class="square" style="width: 40px; height: 40px; margin: 10px; background-color:rgb(160, 160, 160);"></div>
    <div class="square" style="width: 40px; height: 40px; margin: 10px; background-color:rgb(125, 125, 125);"></div>
    <div class="square" style="width: 40px; height: 40px; margin: 10px; background-color:rgb(90, 90, 90);"></div>
    <div class="square" style="width: 40px; height: 40px; margin: 10px; background-color:rgb(55, 55, 55);"></div>
</div>

<div style="display: flex; justify-content: center;">
  <% (0..5).each do |i| %>
    <div class="square" data-level="<%= i %>" style="width: 40px; height: 40px; margin: 10px;"></div>
  <% end %>
</div>

<div style="height: 50px;"></div>

<h3>Forms</h3>

<form action="/style" method="get">
  <label for="test">A label</label>
  <br>
  <input type="text" id="test" placeholder="Some text">
  <br>
  <input type="text" id="test" placeholder="More text">
  <br>
  <input type="submit">
</form>

