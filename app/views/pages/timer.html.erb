<div id="timer"
     data-controller="timer"
     data-timer-sound-value="<%= audio_path("bells.mp3") %>">
  <div id="time" class="inactive" data-timer-target="time"></div>
  <div id="controls">
    <div data-action="click->timer#stop" class="habit">Stop</div>
    <div data-action="click->timer#reset" class="habit">Reset</div>
    <div data-action="click->timer#start" class="habit">Start</div>
  </div>
</div>
