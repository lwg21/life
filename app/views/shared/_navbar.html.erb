<% if authenticated? %>
  <%= link_to root_path do %>
    <%= render "shared/icons/grid3x3" %>
    <div>home</div>
  <% end %>
  <%= link_to habits_path, class: "debug-grey" do %>
    <%= render "shared/icons/list" %>
    <div>habits</div>
  <% end %>
  <%= link_to goals_path, class: "debug-grey" do %>
    <%= render "shared/icons/award" %>
    <div>unlocks</div>
  <% end %>
  <%= link_to "#", class: "debug-grey" do %>
    <%= render "shared/icons/user_settings" %>
    <div>settings</div>
  <% end %>
  <%#= link_to "log out", session_path, data: { turbo_method: :delete } if authenticated? %>
<% else %>
  <%#= link_to "log in", new_session_path unless authenticated? %>
<% end %>
