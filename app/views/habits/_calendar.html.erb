<%# locals: (calendar:) -%>
<div class="calendar mb-m" data-ajax-target="calendar">
  <% calendar.week_days.each do |dayname| %>
    <div class="square weekday"><%= dayname %></div>
  <% end %>

  <% calendar.padding_days_start.times do %>
    <div class="square">
      <div class="cal-dot"></div>
    </div>
  <% end %>

  <% calendar.date_range.each do |day| %>
    <div class="square <%= 'today' if calendar.no_log_today?(day) %>" data-level="<%= calendar.level(day) %>">
      <%= day.day if day.today? %>
    </div>
  <% end %>

  <% calendar.padding_days_end.times do %>
    <div class="square">
      <div class="cal-dot"></div>
    </div>
  <% end %>
</div>
