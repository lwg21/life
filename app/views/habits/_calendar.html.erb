<div class="calendar mb-m">
  <% Date::DAYNAMES.rotate(1).each do |dayname| %>
    <div class="square weekday">
      <%= dayname[0] %>
    </div>
  <% end %>

  <% (date.beginning_of_month.cwday - 1).times do %>
    <div class="square">
      <div class="cal-dot"></div>
    </div>
  <% end %>

  <% (1..date.end_of_month.day).each do |i| %>
    <% scale = data[i] ? (data[i].fdiv(top) * 5).ceil : 0 %>
    <div class="square cal-color<%= scale %> <%= 'today' if date.day == i && scale == 0 %>">
      <%= date.day if date.day == i %>
    </div>
  <% end %>

  <% (7 - date.end_of_month.cwday).times do %>
    <div class="square">
      <div class="cal-dot"></div>
    </div>
  <% end %>
</div>
