<div class="calendar mb-m">
  <% (date.beginning_of_month.cwday - 1).times do %>
    <div class="square">
      <div class="cal-dot"></div>
    </div>
  <% end %>

  <% (1..date.end_of_month.day).each do |i| %>
    <% scale = data[i] ? (data[i].fdiv(top) * 5).ceil : 0 %>
    <div class="square cal-color<%= scale %> <%= 'today' if date.day == i && scale == 0 %>"></div>
  <% end %>

  <% (7 - date.end_of_month.cwday).times do %>
    <div class="square">
      <div class="cal-dot"></div>
    </div>
  <% end %>
</div>

<style>
  .calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
  }

  .square {
    aspect-ratio: 1;
    /* align-content: center; */
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cal-dot {
    background-color: hsl(0, 0.00%, 90%);
    border-radius: 50%;
    height: 6px;
    width: 6px;
  }
  .cal-color0 { background-color:hsl(0, 0.00%, 90%); }
  .cal-color1 { background-color:rgb(133, 202, 174); }
  .cal-color2 { background-color:rgb(90, 166, 134); }
  .cal-color3 { background-color:rgb(51, 129, 96); }
  .cal-color4 { background-color:rgb(31, 109, 77); }
  .cal-color5 { background-color:rgb(9, 75, 48); }
  .today { animation: pulse 2s infinite; }

  @keyframes pulse {
    50% { background-color: hsl(0, 0.00%, 70%); }
    0%, 100% { background-color: hsl(0, 0.00%, 90%); }
  }
</style>
