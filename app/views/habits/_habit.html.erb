<div class="habit-card">
  <%= link_to habit_path(habit) do %>
    <div class="info">
      <div class="title">
        <%= habit.name %>
      </div>
      <div class="streak">
        <strong><%= habit.current_streak %></strong> streak, <strong><%= habit.habit_logs.size %></strong> total
      </div>
      <div class="week">
        <% date_range.each do |day| %>
          <div class="mini-square" data-level="<%= logs_by_habit_and_date[[habit.id, day]] ? '1' : '0' %>">
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if habit.done_today? %>
    <div class="check done">
      <%= icon :check %>
    </div>
  <% else %>
    <%= link_to "", done_habit_path(habit), data: { turbo_method: :post,  action: "click->ajax#done" }, class: "check" %>
  <% end %>
</div>
