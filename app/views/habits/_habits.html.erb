<div class="mb-s" data-ajax-target="habits">
  <% habits.each do |habit| %>
      <% habit_text = "#{habit.name} (#{habit.current_streak})" %>
      <% if habit.done_today? %>
        <div class="habit habit-done"><%= habit_text %></div>
      <% else %>
        <%= link_to habit_text, done_habit_path(habit), data: { turbo_method: :post,  action: "click->ajax#done" }, class: "habit" %>
      <% end %>
  <% end %>
</div>
