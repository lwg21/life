<div>
  <div class="habit-header">
    <%= link_to habit.name, habit_path(habit) %>
    <div>streak: <%= habit.current_streak %>, best: <%= habit.longest_streak %>, total: <%= habit.habit_logs.size %></div>
  </div>
  <div class="calendar">
    <% @date_range.each do |day| %>
      <div class="square" data-level="<%= @logs_by_habit_and_date[[habit.id, day]] ? '3' : '0' %>">
      </div>
    <% end %>
  </div>
</div>
