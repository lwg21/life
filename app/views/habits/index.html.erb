<% @habits.each do |habit| %>
  <div>
    <% if habit.done_today? %>
      <%= habit.name %> ☀️
    <% else %>
      <%= link_to habit.name, done_habit_path(habit), data: { turbo_method: :post } %>
    <% end %>
  </div>
<% end %>

<%= link_to "Reset day", reset_habits_path, data: { turbo_method: :delete } %>
