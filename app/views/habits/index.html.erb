<% @habits.each do |habit| %>
  <div><%= habit.name %></div>
  <div class="calendar">
    <% @date_range.each do |day| %>
      <div class="square cal-color<%= @logs_by_habit_and_date[[habit.id, day]] ? '3' : '0' %>">
        <%= @today.day if @today == day %>
      </div>
    <% end %>
  </div>
  <div>
    <%= link_to "see more", habit_path(habit) %>
  </div>
<% end %>
