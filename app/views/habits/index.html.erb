<% @habits.each do |habit| %>
  <div><%= habit.name %></div>
  <div class="calendar">
    <% ((@today - 6)..@today).each do |day| %>
      <div class="square cal-color<%= @habit_logs_grouped.find { |log| log.habit == habit && log.log_date == day } ? '3' : '0' %>"></div>
    <% end %>
  </div>
  <div>
    <%= link_to "see more", habit_path(habit) %>
  </div>
<% end %>
