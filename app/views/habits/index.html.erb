<div data-controller="ajax">
  <%= render partial: "calendar", locals: @calendar_data %>

  <div class="habits" data-ajax-target="habits">
    <%= render partial: "habit", collection: @habits, locals: { date_range: @date_range, logs_by_habit_and_date: @logs_by_habit_and_date } %>
  </div>

  <div class="actions">
    <%= link_to reset_habits_path, data: { turbo_method: :delete } do %>
      <%= icon :rotate %>
      <div>reset day</div>
    <% end %>
    <%= link_to new_habit_path do %>
      <%= icon :square_plus %>
      <div>add habit</div>
    <% end %>
    <%= link_to timer_path do %>
      <%= icon :timer %>
      <div>timer</div>
    <% end %>
  </div>
</div>
