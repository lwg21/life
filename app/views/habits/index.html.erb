<style>
  .square:first-child {
    background: linear-gradient(to right, transparent, rgba(230, 230, 230, 0.6) 30%);
  }
</style>
<% @habits.each do |habit| %>
  <div><%= habit.name %> (streak: <%= habit.streak %>)</div>
  <div class="calendar">
    <% @date_range.each do |day| %>
      <div class="square cal-color<%= @logs_by_habit_and_date[[habit.id, day]] ? '3' : '0' %>">
        <%= @today.day if @today == day %>
      </div>
    <% end %>
  </div>
<% end %>
