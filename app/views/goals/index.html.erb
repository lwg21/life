<div class="goals">
  <% @goals.each do |goal| %>
    <% unlock = goal.unlocks.find { |u| u.user_id == @user_id } %>
    <% if !unlock %>
      <div>
        <div class="goal locked">
          <%= icon :lock %>
        </div>
      </div>
    <% elsif !unlock.seen_at %>
      <div>
        <%= link_to goal_path(goal), class: "goal hidden" do %>
          <%= icon :sparkles %>
        <% end %>
        <div class="goal-name">New!</div>
      </div>
    <% else %>
      <div>
        <div class="goal <%= goal.code %>">
        </div>
        <div class="goal-name">
          <%= goal.name %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# DEBUG %>
  <% 30.times do %>
    <div>
      <div class="goal locked">
        <%= icon(:lock) %>
      </div>
    </div>
  <% end %>
</div>
