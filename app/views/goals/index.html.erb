<% @goals.group_by(&:category).each do |category, goals| %>
  <div><%= category.capitalize %></div>
  <div class="goals">
    <% goals.each do |goal| %>
      <% if @unlocks_data.key?(goal.id) %>
        <%= link_to goal_path(goal) do %>
          <div class="goal">
            <%= goal.name %>
            <%= "hidden!" unless @unlocks_data[goal.id] %>
          </div>
        <% end %>
      <% else %>
        <div class="goal locked">
          <%= goal.name %>
        </div>
      <% end %>



    <% end %>
  </div>
<% end %>
