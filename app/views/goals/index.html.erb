<div class="goals">
  <% @goals.each do |goal| %>
    <% unlock = goal.unlocks.find { |u| u.user_id == @user_id } %>
    <% if !unlock %>
      <div>
        <div class="goal locked">
          <%= render "shared/icons/lock" %>
        </div>
      </div>
    <% elsif !unlock.seen_at %>
      <div>
        <%= link_to goal_path(goal), class: "goal hidden" do %>
          <%= render "shared/icons/sparkles" %>
        <% end %>
      </div>
    <% else %>
      <div>
        <div class="goal streak">
        </div>
        <div class="goal-name">
          <%= goal.name %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
