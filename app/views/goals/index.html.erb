<% @goals.group_by(&:category).each do |category, goals| %>
  <div><%= category.capitalize %></div>
  <div class="goals">
    <% goals.each do |goal| %>
      <div class="goal <%= 'unlocked' if @unlocked_goal_ids.include?(goal.id) %>">
        <%= goal.name %>
      </div>
    <% end %>
  </div>
<% end %>
